# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Токен бота от @BotFather:
BOT_TOKEN=123456789:замените-на-токен-от-BotFather
# Telegram-id админов через запятую — они пускают игроков (узнать свой id: @userinfobot):
ADMIN_IDS=
# Какие истории загрузить (папки в campaigns/ через запятую); пусто — все:
CAMPAIGNS=
